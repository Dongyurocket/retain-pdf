{
  "name": "retain-pdf-desktop",
  "version": "4.3.13",
  "private": true,
  "description": "RetainPDF desktop wrapper",
  "homepage": "https://github.com/Dongyurocket/retain-pdf",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dongyurocket/retain-pdf.git"
  },
  "author": {
    "name": "wxyhgk",
    "email": "wxyhgk@qq.com"
  },
  "main": "main.js",
  "scripts": {
    "test": "node --test \"src/main/*.test.mjs\"",
    "sync:win-frontend": "node scripts/sync-win-frontend.mjs",
    "install-git-hooks": "sh scripts/install-git-hooks.sh",
    "smoke:frontend-bundle": "node scripts/check-frontend-bundle.mjs",
    "smoke:frontend-desktop": "npm --prefix ../frontend run smoke:desktop-first-run && npm run smoke:frontend-bundle",
    "sync-frontend": "npm --prefix ../frontend run build && node scripts/prepare-app.mjs --frontend-only",
    "verify-frontend-sync": "npm run sync-frontend && npm run smoke:frontend-desktop",
    "prepare-app": "npm --prefix ../frontend run build && node scripts/prepare-app.mjs",
    "dist:win32": "npm run prepare-app && electron-builder --publish never --win portable --x64 --config.directories.output=win",
    "dist:win32-installer": "npm run prepare-app && electron-builder --publish never --win nsis --x64 --config.directories.output=win"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wxyhgk.retainpdf",
    "productName": "RetainPDF",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "app/frontend/**/*",
      "assets/**/*",
      "main.js",
      "preload.js",
      "src/main/**/*",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/backend",
        "to": "backend"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RetainPDF-Windows-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RetainPDF-Windows-${version}-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
